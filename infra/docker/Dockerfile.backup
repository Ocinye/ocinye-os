# syntax=docker/dockerfile:1.7
#
# A imagem efémera de continuidade: `pg_dump`, `mc` e `age`, para correr na rede
# privada do Compose.
#
# # Porque uma imagem à parte, e não a da aplicação
#
# Porque não corre a aplicação. Existe para, uma vez por disparo do agendador,
# alcançar `postgres` e `object-store` pelos nomes internos do Compose, produzir
# o conjunto, cifrá-lo com `age` e enviá-lo para o cofre — e depois desaparecer.
# A imagem da aplicação traz o compilador de Rust e o binário; esta traz um
# cliente de PostgreSQL, um de S3 e o cifrador, e mais nada.
#
# # Porque `postgresql-client-17` e não o do Debian
#
# Porque o servidor é PostgreSQL 17 (`pgvector/pgvector:pg17` no Compose), e um
# `pg_dump` de versão menor recusa-se a ler uma base maior. A versão acompanha a
# do servidor; sai do repositório oficial do PostgreSQL, não do `bookworm`, que
# traz o 15.
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg age \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-17 \
 && curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
 && chmod +x /usr/local/bin/mc \
 && rm -rf /var/lib/apt/lists/*

# Os três scripts juntos: cada um chama os irmãos por `"$(dirname "$0")"`.
COPY scripts/institutional-backup.sh scripts/backup-remote.sh scripts/backup-objects.sh \
     /opt/ocinye/scripts/
RUN chmod +x /opt/ocinye/scripts/*.sh

WORKDIR /opt/ocinye
ENTRYPOINT ["/opt/ocinye/scripts/institutional-backup.sh"]
