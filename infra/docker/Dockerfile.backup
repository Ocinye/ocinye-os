# syntax=docker/dockerfile:1.7
#
# A imagem efémera de continuidade: para correr na rede privada do Compose.
#
# # Porque parte da imagem do Core
#
# Porque o conjunto começa por um **manifesto** — o que o Core diz que tem de
# viajar, identidade a identidade (ADR-0700) —, e quem o emite é o próprio
# binário do Core (`ocinye … snapshot`). A versão do manifesto tem de ser a da
# instalação, por isso parte-se da imagem do Core **do mesmo release**, e não de
# uma cópia do binário que poderia divergir. Por cima vêm só os clientes que o
# transporte usa.
#
# # Porque `postgresql-client-17`
#
# Porque o servidor é PostgreSQL 17 (`pgvector/pgvector:pg17`), e um `pg_dump` de
# versão menor recusa-se a ler uma base maior. Sai do repositório oficial do
# PostgreSQL, não do `bookworm`, que traz o 15.
ARG OCINYE_RELEASE_SHA
FROM ocinye/ocinye-core-server:${OCINYE_RELEASE_SHA}

USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends gnupg age \
 && install -d /usr/share/postgresql-common/pgdg \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
 && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends postgresql-client-17 \
 && curl -fsSL https://dl.min.io/client/mc/release/linux-amd64/mc -o /usr/local/bin/mc \
 && chmod +x /usr/local/bin/mc \
 && rm -rf /var/lib/apt/lists/*

# Os três scripts juntos: cada um chama os irmãos por `"$(dirname "$0")"`.
COPY scripts/institutional-backup.sh scripts/backup-remote.sh scripts/backup-objects.sh \
     /opt/ocinye/scripts/
RUN chmod +x /opt/ocinye/scripts/*.sh

# O binário do Core desta imagem — o que emite o manifesto. Sem isto o script
# procura-o num caminho de desenvolvimento que aqui não existe.
ENV OCINYE_CORE_SERVER_BIN=/usr/local/bin/ocinye
WORKDIR /opt/ocinye
ENTRYPOINT ["/opt/ocinye/scripts/institutional-backup.sh"]
