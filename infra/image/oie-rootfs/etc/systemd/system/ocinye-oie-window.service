[Unit]
Description=Ocinye Installation Environment: the installer, for the native window
# The same engine and the same authority over disks as on a terminal
# (ocinye-oie@.service); the exchange is typed, so that the window can draw an
# interface. The window connects to /run/ocinye/oie.sock, which belongs to its
# account alone.
After=local-fs.target

[Service]
ExecStart=/usr/lib/ocinye/ocinye-oie run --window
# Which step the window is at goes to the journal and to the machine's console
# log: never an argument, never what was typed.
StandardError=journal+console
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
