#!/bin/sh
# Ocinye block guard, part 1 of 3: decide, before udev starts, whether this
# boot of the installation medium may ever write a disk (D013 Live Mode, L0-S).
#
# Armed in every mode except, exactly, `ocinye.mode=install`: Live, Hardware
# Check, Recovery, and a missing, unknown or contradictory mode. The same rule
# as ocinye_image_contracts::bootmode::ResolvedMode::from_cmdline.
#
# Never armed outside the medium (`boot=casper`): an installed system that
# somehow carried this script must not lose its own disks.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
    prereqs
    exit 0
    ;;
esac

mode=""
seen=0
casper=0
for x in $(cat /proc/cmdline); do
    case "$x" in
    -- | ---) break ;;
    boot=casper) casper=1 ;;
    ocinye.mode=*)
        v="${x#ocinye.mode=}"
        if [ "$seen" = 0 ]; then
            mode="$v"
        elif [ "$v" != "$mode" ]; then
            mode="?conflict"
        fi
        seen=1
        ;;
    esac
done

[ "$casper" = 1 ] || exit 0
[ "$mode" = "install" ] && exit 0

mkdir -p /run/ocinye /run/udev/rules.d
echo armed >/run/ocinye/guard
# No software RAID assembly and no LVM activation: an empty file in
# /run/udev/rules.d replaces the rule of the same name, here and after the
# switch to the real root (/run is carried over).
: >/run/udev/rules.d/64-md-raid-assembly.rules
: >/run/udev/rules.d/69-lvm.rules
exit 0
