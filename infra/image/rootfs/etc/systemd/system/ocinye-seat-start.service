[Unit]
Description=Ocinye OS seat: bring the screen up on a machine that has one
Documentation=file:///usr/share/doc/ocinye/images.md
# After the devices have settled: whether there is a display is decided once,
# with every device the kernel found.
ConditionPathExistsGlob=/dev/dri/card*
After=ocinye-firstboot.service systemd-udev-settle.service systemd-user-sessions.service
Wants=systemd-udev-settle.service

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --no-block start ocinye-display.service

[Install]
WantedBy=multi-user.target
