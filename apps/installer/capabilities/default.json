{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The Installer window: its own commands, and nothing else (no filesystem, shell, dialog, opener or network permission for the webview).",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-view",
    "allow-set-lang",
    "allow-start",
    "allow-back",
    "allow-choose-release",
    "allow-continue-release",
    "allow-choose-key",
    "allow-test-connection",
    "allow-continue-server",
    "allow-trust",
    "allow-other-server",
    "allow-forget-server",
    "allow-sudo",
    "allow-cancel-sudo",
    "allow-preflight",
    "allow-continue-preflight",
    "allow-continue-hardware",
    "allow-continue-instance",
    "allow-continue-distributions",
    "allow-set-distributions",
    "allow-set-endpoints",
    "allow-check-dns",
    "allow-continue-endpoints",
    "allow-choose-tls-file",
    "allow-set-tls",
    "allow-continue-tls",
    "allow-continue-admin",
    "allow-change",
    "allow-install",
    "allow-stop",
    "allow-reconnect",
    "allow-resume",
    "allow-remove-incomplete",
    "allow-recheck",
    "allow-reveal-credential",
    "allow-acknowledge-credential",
    "allow-show-credential",
    "allow-show-receipt",
    "allow-save-receipt",
    "allow-open-ocinye"
  ]
}