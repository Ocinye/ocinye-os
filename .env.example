# Ocinye OS — example configuration.
#
# Copy to `.env` and adjust. This file contains NO secrets and never will:
# every value here is a placeholder or a safe default (CLAUDE.md §39, §55).
#
# Values marked REQUIRED have no default. A service that needs one and does not
# find it refuses to start rather than assuming something.

# --- Environment -----------------------------------------------------------
# development | staging | production
# Production additionally requires HTTPS issuers, secure cookies and rejects a
# wildcard CORS origin.
OCINYE_ENVIRONMENT=development
OCINYE_LOG_LEVEL=info
# json | pretty  (json outside development)
OCINYE_LOG_FORMAT=pretty

# --- Organisation ----------------------------------------------------------
OCINYE_ORGANISATION_SLUG=ocinye

# --- Ocinye Core -----------------------------------------------------------
OCINYE_BIND_ADDRESS=0.0.0.0:8080
# REQUIRED. The port matches infra/compose/docker-compose.yml.
OCINYE_DATABASE_URL=postgres://ocinye:ocinye_dev_only@localhost:5442/ocinye
OCINYE_DATABASE_MAX_CONNECTIONS=10
OCINYE_REDIS_URL=redis://localhost:6380

# Origins allowed to call the Core from a browser. Empty means none, which is
# correct: the Core is normally reached by the Workspace server, not directly.
# A wildcard is refused in production.
OCINYE_CORS_ALLOWED_ORIGINS=

# --- Authentication (ADR-0020, ADR-0021) -----------------------------------
# The Core is the authentication authority: username and password, with
# Argon2id verifiers. It never stores a password in any reversible form.
#
# Cost parameters. Validated at startup IN EVERY ENVIRONMENT: below the floor
# the Core refuses to start rather than write weak verifiers. Calibrate on the
# deployment host towards ~500 ms per verification; see docs/password-policy/.
OCINYE_ARGON2_MEMORY_KIB=19456
OCINYE_ARGON2_ITERATIONS=2
OCINYE_ARGON2_PARALLELISM=1

# How long a temporary credential stays usable. Must be positive: a credential
# that never expires is a permanent password wearing the wrong label.
OCINYE_TEMPORARY_CREDENTIAL_HOURS=24

# Sign-in throttling. Counted per account AND per network prefix, over a rolling
# window. Deliberately not an account lockout: locking after N failures hands a
# denial of service to anyone who knows an address.
OCINYE_THROTTLE_PER_EMAIL=10
OCINYE_THROTTLE_PER_IP=20
OCINYE_THROTTLE_WINDOW_MINUTES=15

# --- Identity federation (PLANNED, not used) -------------------------------
# Retained so that federating an external provider later needs no schema
# migration. Leave EMPTY: nothing reads it to authenticate today. If set, it
# must be https in production.
OCINYE_OIDC_ISSUER=
OCINYE_OIDC_AUDIENCE=ocinye-core
OCINYE_OIDC_JWKS_CACHE_SECONDS=300

# --- Object storage (S3-compatible) ----------------------------------------
# Absent storage is a legitimate state: the Core starts and reports it.
OCINYE_STORAGE_ENDPOINT_URL=http://localhost:9000
OCINYE_STORAGE_REGION=us-east-1
OCINYE_STORAGE_ACCESS_KEY=ocinye_dev
OCINYE_STORAGE_SECRET_KEY=CHANGE_ME
OCINYE_STORAGE_BUCKET=ocinye-artifacts
OCINYE_STORAGE_BACKEND_CODE=local-minio
OCINYE_STORAGE_LOCATION_LABEL=local-development
# UNDECLARED | THIRD_PARTY_CLOUD | OCINYE_CAMAMA | OCINYE_COLOCATION
# Leave UNDECLARED unless Ocinye actually owns the infrastructure. The system
# must never claim residency it does not have (ADR-0016).
OCINYE_STORAGE_RESIDENCY=UNDECLARED
OCINYE_STORAGE_MAX_UPLOAD_BYTES=536870912

# --- AI Gateway ------------------------------------------------------------
# Capability -> model name. Configuration, never code (ADR-0013).
# EMPTY IS CORRECT TODAY: no Ocinye AI node exists, so no capability is served
# and the platform reports AI as unavailable. It never falls back to an
# external provider.
#
# When a node is enrolled, this becomes for example:
#   OCINYE_AI_CAPABILITY_MAP=GENERAL=qwen2.5,CODING=qwen2.5-coder,REASONING=deepseek-r1
OCINYE_AI_CAPABILITY_MAP=
# Selecting an externally hosted model requires an explicit institutional
# decision and its own ADR. Off by default.
OCINYE_AI_ALLOW_EXTERNAL_PROVIDERS=false

# --- Compute Plane ---------------------------------------------------------
OCINYE_COMPUTE_ENROLLMENT_TOKEN_TTL_SECONDS=3600
OCINYE_COMPUTE_NODE_OFFLINE_AFTER_SECONDS=120

# --- Ocinye Workspace ------------------------------------------------------
OCINYE_WORKSPACE_BIND_ADDRESS=0.0.0.0:8090
# REQUIRED. Must be https in production.
OCINYE_WORKSPACE_PUBLIC_URL=http://localhost:8090
# REQUIRED. Where the Workspace reaches the Core. Must be https in production:
# this is the hop a password travels over at sign-in.
OCINYE_CORE_URL=http://localhost:8080
OCINYE_WORKSPACE_SESSION_TTL_SECONDS=28800
# Set to 1 only for plain-HTTP local development. Refused in production.
OCINYE_WORKSPACE_COOKIE_INSECURE=1
# Where the stylesheet, the icon sprite and the logo are served from. The
# default assumes the Workspace runs from the repository root; a deployment that
# copies the static files elsewhere points this at them.
OCINYE_WORKSPACE_STATIC_DIR=apps/workspace/static

# --- Capability Runtime ----------------------------------------------------
# Onde estão os componentes WebAssembly que o Core executa em isolamento. O
# valor por omissão é o directório de build do repositório, produzido por
# `./scripts/build-capabilities.sh`. Qual o componente que cada operação usa não
# se configura aqui: é decisão do Core.
OCINYE_CAPABILITY_COMPONENTS_DIR=target/wasm32-wasip1/release

# --- Ocinye Mail -----------------------------------------------------------
# All of these together, or none of them. The Core refuses to start on a
# partial configuration: a half-configured mail service looks available and
# fails at the moment somebody presses "Enviar".
#
# There is NO password in this file and there never will be one. An absent
# credential means mail is not configured, which is a true and valid state.
# Put the real values in `.env.local` (gitignored) or the deployment secret
# store. See docs/runbooks/configure-mail-service.md.
#
# Verify a configuration without starting the Core, and without printing
# anything unsafe to paste into a ticket:
#     ocinye-core-server mail-check
#
# Domains that count as inside the institution. Without it every recipient is
# external, so the Core refuses to start with mail configured and this empty.
# OCINYE_MAIL_INSTITUTIONAL_DOMAINS=example.org
#
# IMAP, for reading. 993 with implicit TLS is the norm.
# OCINYE_MAIL_IMAP_HOST=mail.example.org
# OCINYE_MAIL_IMAP_PORT=993
# OCINYE_MAIL_IMAP_TLS=tls
#
# SMTP, for sending. 465 is implicit TLS; 587 is STARTTLS.
# OCINYE_MAIL_SMTP_HOST=mail.example.org
# OCINYE_MAIL_SMTP_PORT=465
# OCINYE_MAIL_SMTP_TLS=tls
#
# `*_TLS` accepts `tls` (implicit, from the first byte) or `starttls` (upgrade
# a plain socket). It does NOT accept `false`, `none` or `off`: the Core
# refuses to start rather than send the mailbox password over the wire in the
# clear. Absent means the convention for the port, which always encrypts.
#
# The institution's own account, and the first of two credentials (ADR-0409).
#
# This one is not a person's. It is what the `worker` uses to index mail and
# what sustains agentic work — jobs nobody in particular is doing, and which
# therefore cannot borrow anybody's identity. Most services want the full
# email address. Use a mailbox created for the Ocinye OS.
# OCINYE_MAIL_USERNAME=service@example.org
# OCINYE_MAIL_PASSWORD=<supplied through the deployment secret store>
#
# OCINYE_MAIL_MAX_MESSAGE_BYTES=26214400
#
# The key that encrypts the second credential: each member's own mailbox
# password, which they enter in the Workspace and which never leaves the Core
# again. 32 bytes, base64. Generate one with:
#     ocinye-core-server mail-key
#
# Absent, connecting a mailbox refuses with that reason stated — which is the
# correct behaviour of an installation without a key, not a gap to paper over.
# It is deliberately NOT generated at startup: a key that changed on every
# restart would make every connected mailbox unreadable without anybody having
# asked for it. Rotating it has the same effect, so members reconnect after.
# OCINYE_MAIL_KEY=<supplied through the deployment secret store>

# --- Node agent (runs on a compute node, not on this host) -----------------
# No Ocinye compute node exists yet; these are here so the shape is documented.
# OCINYE_CORE_URL=https://core.example.org
# OCINYE_NODE_ENROLLMENT_TOKEN=<single-use, issued when the node is registered>
# OCINYE_NODE_TOKEN_PATH=/var/lib/ocinye/agent.token
# OCINYE_NODE_HEARTBEAT_SECONDS=30

# --- Local infrastructure (docker compose) ---------------------------------
#
# The data services bind to the loopback interface by default. They carry the
# placeholder credentials in this file, so publishing them on every interface
# would offer a database with a known password to whatever network the machine
# happens to be on. Override only with a reason (CLAUDE.md §56).
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
MINIO_BIND=127.0.0.1
POSTGRES_USER=ocinye
POSTGRES_PASSWORD=ocinye_dev_only
POSTGRES_DB=ocinye
POSTGRES_PORT=5442
REDIS_PORT=6380
MINIO_ROOT_USER=ocinye_dev
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# There is no default administrator, and no bootstrap password in this file.
# The first PlatformAdmin is created once, by:
#   ocinye-core-server bootstrap-admin --name … --username … --email …
# which prints a temporary credential exactly once. See
# docs/runbooks/bootstrap-first-administrator.md.
